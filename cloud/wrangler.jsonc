{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go3v3",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // 静的ファイル(クライアント)も同じWorkerから配信する。画面は / だけなので、無いファイルは 404 にする
  // (以前は index.html を返していたため、AIのモデルが無いことに気づけなかった)
  "assets": { "directory": "../public", "not_found_handling": "none", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
      { "name": "ROOM", "class_name": "GameRoomDO" }
    ]
  },
  // 無料プランでは SQLite 版の Durable Object のみ使える
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchmakerDO", "GameRoomDO"] }],
  // IPごとのレート制限(Workers Rate Limiting は無料プランでも使える)。period は 10 か 60 秒
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": { "QUEUE_WAIT_MS": "20000", "CPU_DELAY_MS": "700", "MOVE_SECONDS": "30" }
}
