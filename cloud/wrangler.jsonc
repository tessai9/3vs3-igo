{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go3v3",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // 静的ファイル(クライアント)も同じWorkerから配信する
  "assets": { "directory": "../public", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/ws"] },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
      { "name": "ROOM", "class_name": "GameRoomDO" }
    ]
  },
  // 無料プランでは SQLite 版の Durable Object のみ使える
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchmakerDO", "GameRoomDO"] }],
  "vars": { "QUEUE_WAIT_MS": "20000", "CPU_DELAY_MS": "700", "MOVE_SECONDS": "30" }
}
