{
  "name": "go3v3-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js && node tools/copy-ort.mjs",
    "start": "npm run build && tsx src/server/server.ts",
    "dev": "node tools/copy-ort.mjs && (esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js --watch & tsx watch src/server/server.ts)",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "models": "sh tools/fetch-models.sh",
    "ai-match": "tsx tools/ai-match.ts",
    "app:sync": "npm run build && cap sync",
    "app:android": "npm run app:sync && cd android && ./gradlew assembleDebug",
    "app:open:ios": "npm run app:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "onnxruntime-web": "^1.31.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
